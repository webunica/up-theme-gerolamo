{%- if icons != blank -%}
{%- assign image = 'icon_image' | append: forloop_index -%}
{%- assign image = icons.settings[image] -%}
{%- if image != blank -%}

{%- liquid
	if icons_size != blank
    assign image_size = icons_size
    assign image_size2 = icons_size | times: 2
    else
    assign image_size = '20'
    assign image_size2 = '40'
    endif
-%}

<img srcset="{{ image | image_url: height: image_size }} 1x, {{ image | image_url: height: image_size2 }} 2x"
     src="{{ image | image_url: image_size }}"
     loading="lazy"
     class="menu-icon-image"
     width="{{ image.width }}"
     height="{% if icons_size == "imageheight" %}{{ image.height }}{% elsif icons_size != blank %}{{ icons_size }}{% else %}20{% endif %}"
     alt="{{ image.alt }}"
     >
{%- else -%}
{%- assign icon_name = 'icon' | append: forloop_index -%}
{%- assign icon_name = icons.settings[icon_name] -%}
{%- if icon_name != blank -%}
{%- render 'icons-list' icon_name: icon_name -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}