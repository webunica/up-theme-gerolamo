{% comment %}
  Mini product item snippet for gerolamo species featured section
{% endcomment %}
{%- if link != blank -%}
  <a href="{{ link }}" class="gerolamo-mini-product">
{%- else -%}
  <div class="gerolamo-mini-product">
{%- endif -%}

  <div class="gerolamo-mini-product__img-wrap">
    {%- if image != blank -%}
      <img src="{{ image | image_url: width: 250 }}"
           alt="{{ title | escape }}"
           loading="lazy"
           width="120"
           height="120">
    {%- else -%}
      <div style="width:70px;height:95px;background:#f8fafc;border-radius:8px;border:1px dashed #cbd5e1;display:flex;align-items:center;justify-content:center;font-size:10px;color:#94a3b8;">
        Foto
      </div>
    {%- endif -%}
  </div>

  <p class="gerolamo-mini-product__title">{{ title }}</p>
  {%- if sub != blank -%}
    <p class="gerolamo-mini-product__subtitle">{{ sub }}</p>
  {%- endif -%}

{%- if link != blank -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}
