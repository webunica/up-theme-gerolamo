{%- liquid
  assign bg_image = section.settings.background_image
  if section.settings.use_collection_image
    if collection.image != blank
      assign bg_image = collection.image
    elsif collection.featured_image != blank
      assign bg_image = collection.featured_image
    endif
  endif
  
  if bg_image == blank
    if collection.image != blank
      assign bg_image = collection.image
    elsif collection.featured_image != blank
      assign bg_image = collection.featured_image
    endif
  endif

  assign bg_image_mobile = section.settings.background_image_mobile
  if bg_image_mobile == blank
    assign bg_image_mobile = bg_image
  endif

  assign show_breadcrumbs = section.settings.show_breadcrumbs
  assign show_eyebrow = section.settings.show_eyebrow
  assign eyebrow = section.settings.eyebrow_text | default: 'NUTRICIÓN SUPERIOR'
-%}

<style>
  #theme-section-{{ section.id }}.gerolamo-col-hero,
  .gerolamo-col-hero {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.desktop_image_height | default: 400 }}px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: {{ section.settings.color_background | default: '#f8fafc' }};
  }

  @media (max-width: 768px) {
    #theme-section-{{ section.id }}.gerolamo-col-hero,
    .gerolamo-col-hero {
      min-height: {{ section.settings.mobile_image_height | default: 280 }}px;
    }
  }

  .gerolamo-col-hero__bg-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-size: cover;
    background-position: {{ section.settings.imagealign | default: 'center right' }};
    background-repeat: no-repeat;
  }

  .gerolamo-col-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.imagealign | default: 'center right' }};
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  .gerolamo-col-hero__gradient-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0.94) 30%, rgba(255, 255, 255, 0.72) 48%, rgba(255, 255, 255, 0.2) 68%, rgba(255, 255, 255, 0) 85%);
    pointer-events: none;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .gerolamo-col-hero__gradient-mask {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 55%, rgba(255, 255, 255, 0.35) 100%);
    }
  }

  .gerolamo-col-hero__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--page-width, 1320px);
    margin: 0 auto;
    padding: 36px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
    box-sizing: border-box;
  }

  .gerolamo-col-hero__breadcrumbs {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 500;
    color: #475569;
    margin-bottom: 20px;
  }

  .gerolamo-col-hero__breadcrumbs a {
    color: #1B4B8A;
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .gerolamo-col-hero__breadcrumbs a:hover {
    text-decoration: underline;
    color: #0F6445;
  }

  .gerolamo-col-hero__bc-sep {
    color: #94a3b8;
    font-size: 13px;
    font-weight: 400;
  }

  .gerolamo-col-hero__bc-home {
    display: inline-flex;
    align-items: center;
    color: #1B4B8A !important;
  }

  .gerolamo-col-hero__bc-current {
    color: #1e293b;
    font-weight: 600;
  }

  .gerolamo-col-hero__text-box {
    max-width: 580px;
    {% if section.settings.text_align == 'text-center' %}
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    {% else %}
    text-align: left;
    {% endif %}
  }

  .gerolamo-col-hero__eyebrow {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: {{ section.settings.color_eyebrow | default: '#1B4B8A' }};
    margin-bottom: 8px;
  }

  .gerolamo-col-hero__title {
    margin: 0 0 12px 0;
    font-size: 40px;
    font-weight: 800;
    color: {{ section.settings.color_title | default: '#0f2b48' }};
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  @media (max-width: 768px) {
    .gerolamo-col-hero__title {
      font-size: 28px;
    }
  }

  .gerolamo-col-hero__desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: {{ section.settings.color_description | default: '#334155' }};
    font-weight: 400;
  }

  .gerolamo-col-hero__desc p {
    margin: 0 0 8px 0;
  }

  .gerolamo-col-hero__desc p:last-child {
    margin-bottom: 0;
  }
</style>

<div id="theme-section-{{ section.id }}" class="gerolamo-col-hero" data-section-name="main-collection-banner">
  <!-- Background Image with Soft Gradient Mask -->
  {%- if bg_image != blank -%}
    <div class="gerolamo-col-hero__bg-wrap" style="background-image: url('{{ bg_image | image_url: width: 2400 }}');">
      <img src="{{ bg_image | image_url: width: 2400 }}"
           alt="{{ collection.title | escape }}"
           class="gerolamo-col-hero__bg-img{% if bg_image_mobile != blank and bg_image_mobile != bg_image %} hide-sp{% endif %}"
           loading="eager"
           width="{{ bg_image.width }}"
           height="{{ bg_image.height }}">
      {%- if bg_image_mobile != blank and bg_image_mobile != bg_image -%}
      <img src="{{ bg_image_mobile | image_url: width: 1200 }}"
           alt="{{ collection.title | escape }}"
           class="gerolamo-col-hero__bg-img hide-desktop"
           loading="eager"
           width="{{ bg_image_mobile.width }}"
           height="{{ bg_image_mobile.height }}">
      {%- endif -%}
      <div class="gerolamo-col-hero__gradient-mask"></div>
    </div>
  {%- endif -%}

  <!-- Content Container -->
  <div class="gerolamo-col-hero__inner">
    
    <!-- Integrated Breadcrumbs -->
    {%- if show_breadcrumbs -%}
    <nav class="gerolamo-col-hero__breadcrumbs" aria-label="Navegación">
      <a href="{{ routes.root_url }}" class="gerolamo-col-hero__bc-home" aria-label="Inicio">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
      </a>
      <span class="gerolamo-col-hero__bc-sep">›</span>
      <a href="{{ routes.root_url }}">Inicio</a>
      <span class="gerolamo-col-hero__bc-sep">›</span>
      {%- if collection.title contains 'Perro' or collection.title contains 'Canino' -%}
        <a href="/collections/perros">Perros</a>
        <span class="gerolamo-col-hero__bc-sep">›</span>
      {%- elsif collection.title contains 'Gato' or collection.title contains 'Felino' -%}
        <a href="/collections/gatos">Gatos</a>
        <span class="gerolamo-col-hero__bc-sep">›</span>
      {%- endif -%}
      <span class="gerolamo-col-hero__bc-current">{{ collection.title }}</span>
    </nav>
    {%- endif -%}

    <div class="gerolamo-col-hero__text-box">
      {%- if show_eyebrow and eyebrow != blank -%}
      <div class="gerolamo-col-hero__eyebrow">
        {{ eyebrow }}
      </div>
      {%- endif -%}

      {%- if section.settings.show_title -%}
      <h1 class="gerolamo-col-hero__title">
        {{ collection.title }}
      </h1>
      {%- endif -%}

      {%- if collection.description != blank and section.settings.show_text_description -%}
      <div class="gerolamo-col-hero__desc">
        {{ collection.description }}
      </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Banner de Colección",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Imagen de Fondo"
    },
    {
      "type": "checkbox",
      "id": "use_collection_image",
      "default": true,
      "label": "Usar imagen de la colección"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de fondo alternativa"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Imagen de fondo (Móvil)"
    },
    {
      "type": "select",
      "id": "imagealign",
      "label": "Posición de la imagen",
      "default": "center right",
      "options": [
        {
          "value": "center right",
          "label": "Centro Derecha"
        },
        {
          "value": "center center",
          "label": "Centro"
        },
        {
          "value": "top right",
          "label": "Superior Derecha"
        },
        {
          "value": "bottom right",
          "label": "Inferior Derecha"
        }
      ]
    },
    {
      "type": "header",
      "content": "Dimensiones"
    },
    {
      "type": "range",
      "id": "desktop_image_height",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Altura en escritorio",
      "default": 380
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "min": 180,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Altura en móvil",
      "default": 280
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "Mostrar migas de pan"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "default": true,
      "label": "Mostrar antetítulo"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "default": "NUTRICIÓN SUPERIOR",
      "label": "Texto del antetítulo"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "default": true,
      "label": "Mostrar título"
    },
    {
      "type": "checkbox",
      "id": "show_text_description",
      "default": true,
      "label": "Mostrar descripción"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        {
          "value": "text-left",
          "label": "Izquierda"
        },
        {
          "value": "text-center",
          "label": "Centro"
        }
      ],
      "default": "text-left",
      "label": "Alineación del texto"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "color_title",
      "default": "#0f2b48",
      "label": "Color del título"
    },
    {
      "type": "color",
      "id": "color_eyebrow",
      "default": "#1B4B8A",
      "label": "Color del antetítulo"
    },
    {
      "type": "color",
      "id": "color_description",
      "default": "#334155",
      "label": "Color de la descripción"
    },
    {
      "type": "color",
      "id": "color_background",
      "default": "#f8fafc",
      "label": "Color de fondo fallback"
    }
  ]
}
{% endschema %}
