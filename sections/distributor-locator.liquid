{{ 'section-distributor-locator.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="{{ 'section-distributor-locator.js' | asset_url }}" defer="defer"></script>

<style>
  #theme-section-{{ section.id }} {
    {% if section.settings.section_bg_color != blank and section.settings.section_bg_color != 'rgba(0,0,0,0)' %}
      background-color: {{ section.settings.section_bg_color }};
    {% endif %}
    {% if section.settings.section_bg_image != blank %}
      background-image: url({{ section.settings.section_bg_image | image_url: width: 2000 }});
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  #theme-section-{{ section.id }} .distributor-locator__hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.hero_height_desktop | default: 360 }}px;
    padding: 50px 0;
    overflow: hidden;
    text-align: {{ section.settings.hero_text_align | default: 'left' }};
  }

  #theme-section-{{ section.id }} .distributor-locator__hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  #theme-section-{{ section.id }} .distributor-locator__hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  #theme-section-{{ section.id }} .distributor-locator__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #theme-section-{{ section.id }} .distributor-locator__hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.hero_overlay_color | default: '#000000' }};
    opacity: {{ section.settings.hero_overlay_opacity | default: 25 | divided_by: 100.0 }};
    z-index: 1;
  }

  #theme-section-{{ section.id }} .distributor-locator__hero-title {
    color: {{ section.settings.hero_text_color | default: '#ffffff' }} !important;
    font-size: {{ section.settings.hero_title_size | default: 36 }}px !important;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin: 0 0 12px;
    line-height: 1.15;
  }

  #theme-section-{{ section.id }} .distributor-locator__hero-sub {
    color: {{ section.settings.hero_sub_color | default: '#fcd34d' }} !important;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  #theme-section-{{ section.id }} .distributor-locator__hero-desc {
    color: {{ section.settings.hero_text_color | default: '#ffffff' }} !important;
    opacity: 0.95;
    font-size: 16px;
    max-width: 600px;
    margin: {% if section.settings.hero_text_align == 'center' %}0 auto{% elsif section.settings.hero_text_align == 'right' %}0 0 0 auto{% else %}0{% endif %};
  }

  @media (max-width: 767px) {
    #theme-section-{{ section.id }} .distributor-locator__hero {
      min-height: {{ section.settings.hero_height_mobile | default: 220 }}px;
      padding: 35px 0;
    }
    #theme-section-{{ section.id }} .distributor-locator__hero-title {
      font-size: clamp(20px, 6vw, 28px) !important;
    }
  }
</style>

<div
  id="theme-section-{{ section.id }}"
  class="distributor-locator top-spacing-{{ section.settings.top_spacing }}"
  data-section-id="{{ section.id }}"
  data-json-url="{{ 'distribuidores.json' | asset_url }}"
  data-radius="{{ section.settings.nearby_radius | default: 100 }}"
  data-per-page="{{ section.settings.items_per_page | default: 18 }}"
>

  <!-- Hero Header -->
  <div class="distributor-locator__hero{% if section.settings.hero_image != blank %} distributor-locator__hero--has-bg{% endif %}">
    {% if section.settings.hero_image != blank %}
      <div class="distributor-locator__hero-bg">
        <picture>
          {% if section.settings.hero_image_mobile != blank %}
            <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 800 }}">
          {% endif %}
          <img
            src="{{ section.settings.hero_image | image_url: width: 2000 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
            width="{{ section.settings.hero_image.width }}"
            height="{{ section.settings.hero_image.height }}"
            class="distributor-locator__hero-img"
          >
        </picture>
        <div class="distributor-locator__hero-overlay"></div>
      </div>
    {% endif %}

    <div class="page-width distributor-locator__hero-content">
      {% if section.settings.subheading != blank %}
        <p class="distributor-locator__hero-sub">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="distributor-locator__hero-title">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="distributor-locator__hero-desc">{{ section.settings.description }}</p>
      {% endif %}
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="distributor-locator__controls">
    <div class="page-width">
      <div class="distributor-locator__controls-inner">

        {% if section.settings.show_search %}
        <div class="distributor-locator__search-wrap">
          <label for="dloc-search-{{ section.id }}" class="visually-hidden">Buscar distribuidor</label>
          <div class="distributor-locator__search-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <input
            id="dloc-search-{{ section.id }}"
            class="distributor-locator__search"
            type="search"
            placeholder="{{ section.settings.search_placeholder | default: 'Buscar por nombre o ciudad' }}"
            autocomplete="off"
          >
          <button class="distributor-locator__search-clear" aria-label="Limpiar" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        {% endif %}

        {% if section.settings.show_region_filter %}
        <div class="distributor-locator__filter-wrap">
          <label for="dloc-region-{{ section.id }}" class="visually-hidden">Filtrar por region</label>
          <select id="dloc-region-{{ section.id }}" class="distributor-locator__region-select">
            <option value="">{{ section.settings.region_all_label | default: 'Todas las regiones' }}</option>
          </select>
          <div class="distributor-locator__select-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
        {% endif %}

      </div>

      <p class="distributor-locator__count" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>

  <!-- Geolocation Notification Banner -->
  <div class="distributor-locator__geo-banner" hidden>
    <div class="page-width">
      <div class="distributor-locator__geo-banner-inner">
        <span class="distributor-locator__geo-banner-text"></span>
        <div class="distributor-locator__geo-banner-actions">
          <button class="distributor-locator__geo-show-all dloc-btn dloc-btn--outline" hidden>Ver todos los distribuidores</button>
          <button class="distributor-locator__geo-locate dloc-btn dloc-btn--ghost" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.94 11a8 8 0 1 0-7.94 8.94"/><path d="M22 12h-4"/><path d="M12 22v-4"/><path d="M12 2v4"/><path d="M2 12h4"/></svg>
            Detectar mi ubicación
          </button>
        </div>
        <button class="distributor-locator__geo-banner-close" aria-label="Cerrar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Split Layout (Left: 2 Columns Cards, Right: Interactive OpenStreetMap) -->
  <div class="distributor-locator__body">
    <div class="page-width">

      <!-- Mobile Tab Selector -->
      {% if section.settings.show_map %}
      <div class="distributor-locator__mobile-toggle">
        <button type="button" class="distributor-locator__tab-btn is-active" data-tab="list">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          <span>Ver Lista</span>
        </button>
        <button type="button" class="distributor-locator__tab-btn" data-tab="map">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
          <span>Ver Mapa</span>
        </button>
      </div>
      {% endif %}

      <div class="distributor-locator__layout{% unless section.settings.show_map %} distributor-locator__layout--no-map{% endunless %}">
        
        <!-- Left: 2 Columns Cards Pane -->
        <div class="distributor-locator__cards-pane">
          <div
            id="dloc-grid-{{ section.id }}"
            class="distributor-locator__grid distributor-locator__grid--{{ section.settings.columns | default: '2' }}"
            data-columns="{{ section.settings.columns | default: '2' }}"
          >
            <div class="distributor-locator__skeleton-grid">
              {% for i in (1..6) %}
              <div class="distributor-locator__skeleton-card">
                <div class="dloc-skel-line dloc-skel-line--badge"></div>
                <div class="dloc-skel-line dloc-skel-line--title"></div>
                <div class="dloc-skel-line dloc-skel-line--text"></div>
                <div class="dloc-skel-line dloc-skel-line--text-sm"></div>
                <div class="dloc-skel-btns">
                  <div class="dloc-skel-line dloc-skel-line--btn"></div>
                  <div class="dloc-skel-line dloc-skel-line--btn"></div>
                </div>
              </div>
              {% endfor %}
            </div>
          </div>

          <!-- Pagination -->
          <div id="dloc-pagination-{{ section.id }}" class="distributor-locator__pagination" style="display: none;" hidden></div>

          <div id="dloc-empty-{{ section.id }}" class="distributor-locator__empty" style="display: none;" hidden>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <p>{{ section.settings.empty_message | default: 'No se encontraron distribuidores para tu búsqueda.' }}</p>
            <button class="distributor-locator__empty-reset dloc-btn dloc-btn--outline">Mostrar todos</button>
          </div>
        </div>

        <!-- Right: OpenStreetMap Container (Leaflet) -->
        {% if section.settings.show_map %}
        <div class="distributor-locator__map-pane">
          <div class="distributor-locator__map-loader" id="dloc-map-loader-{{ section.id }}">
            <div class="dloc-map-spinner"></div>
            <span>Cargando mapa interactivo...</span>
          </div>
          <div
            id="dloc-openmap-{{ section.id }}"
            class="distributor-locator__openmap"
            data-zoom="{{ section.settings.map_zoom | default: 6 }}"
            data-lat="{{ section.settings.map_center_lat | default: '-35.6751' }}"
            data-lng="{{ section.settings.map_center_lng | default: '-71.5430' }}"
          ></div>
        </div>
        {% endif %}

      </div>

    </div>
  </div>

</div>

{% schema %}
{
  "name": "Distribuidores",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen de fondo del banner (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Imagen de fondo del banner (Mobile - Opcional)"
    },
    {
      "type": "range",
      "id": "hero_height_desktop",
      "min": 150,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 360,
      "label": "Altura del banner (Desktop)"
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "min": 120,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 220,
      "label": "Altura del banner (Mobile)"
    },
    {
      "type": "select",
      "id": "hero_text_align",
      "label": "Alineacion del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Color del titulo y texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hero_sub_color",
      "label": "Color del subtitulo",
      "default": "#fcd34d"
    },
    {
      "type": "range",
      "id": "hero_title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36,
      "label": "Tamaño del titulo"
    },
    {
      "type": "color",
      "id": "hero_overlay_color",
      "label": "Color de superposicion (Overlay)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "hero_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 25,
      "label": "Opacidad de superposicion"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitulo",
      "default": "Red de distribuidores"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Donde comprar"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripcion",
      "default": "Encuentra el punto de venta mas cercano a tu ubicacion."
    },
    {
      "type": "header",
      "content": "Busqueda y filtros"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar buscador",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder del buscador",
      "default": "Buscar por nombre o ciudad"
    },
    {
      "type": "checkbox",
      "id": "show_region_filter",
      "label": "Mostrar filtro por region",
      "default": true
    },
    {
      "type": "text",
      "id": "region_all_label",
      "label": "Etiqueta todas las regiones",
      "default": "Todas las regiones"
    },
    {
      "type": "range",
      "id": "nearby_radius",
      "label": "Radio de cercania (km)",
      "info": "Distribuidores visibles al detectar ubicacion del visitante.",
      "min": 25,
      "max": 300,
      "step": 25,
      "default": 100,
      "unit": "km"
    },
    {
      "type": "textarea",
      "id": "empty_message",
      "label": "Mensaje sin resultados",
      "default": "No se encontraron distribuidores para tu busqueda."
    },
    {
      "type": "header",
      "content": "Mapa interactivo (OpenStreetMap)"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Mostrar mapa interactivo (OpenStreetMap)",
      "default": true
    },
    {
      "type": "range",
      "id": "map_zoom",
      "label": "Zoom inicial del mapa",
      "min": 4,
      "max": 14,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "map_center_lat",
      "label": "Latitud central del mapa",
      "default": "-35.6751",
      "info": "Chile central por defecto"
    },
    {
      "type": "text",
      "id": "map_center_lng",
      "label": "Longitud central del mapa",
      "default": "-71.5430"
    },
    {
      "type": "header",
      "content": "Grilla y Paginacion"
    },
    {
      "type": "range",
      "id": "items_per_page",
      "label": "Tarjetas por pagina",
      "min": 6,
      "max": 36,
      "step": 6,
      "default": 18
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "1", "label": "1 columna" },
        { "value": "2", "label": "2 columnas" },
        { "value": "3", "label": "3 columnas" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Fondo general de la seccion"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Color de fondo de la seccion",
      "default": "#f5f3ec"
    },
    {
      "type": "image_picker",
      "id": "section_bg_image",
      "label": "Imagen de fondo de toda la seccion (opcional)"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Espaciado superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "small", "label": "Pequeño" },
        { "value": "medium", "label": "Mediano" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    {
      "name": "Distribuidores",
      "settings": {
        "heading": "Donde comprar",
        "subheading": "Red de distribuidores",
        "description": "Encuentra el punto de venta mas cercano a tu ubicacion.",
        "show_search": true,
        "show_region_filter": true,
        "show_map": true,
        "columns": "2"
      }
    }
  ]
}
{% endschema %}
