{% comment %}
  Gerolamo Official Footer Section
  5 Columnas: Marca y RRSS | Productos | Nosotros | Ayuda | Contacto & Sello Superfood | Barra Copyright & Políticas
{% endcomment %}

<style>
  .gerolamo-footer {
    background-color: var(--footer-bg, #1B4B8A);
    color: var(--footer-text, #ffffff);
    padding-top: var(--footer-pt, 50px);
    padding-bottom: var(--footer-pb, 25px);
    font-size: 14px;
    line-height: 1.5;
  }

  .gerolamo-footer a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .gerolamo-footer a:hover {
    opacity: 0.8;
  }

  .gerolamo-footer__main-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1.6fr;
    gap: 36px;
    align-items: flex-start;
    padding-bottom: 40px;
  }

  @media (max-width: 1200px) {
    .gerolamo-footer__main-grid {
      grid-template-columns: 1.3fr 0.9fr 0.9fr 0.9fr 1.5fr;
      gap: 24px;
    }
  }

  @media (max-width: 991px) {
    .gerolamo-footer__main-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 576px) {
    .gerolamo-footer__main-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* Column 1: Brand Info */
  .gerolamo-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .gerolamo-footer__logo {
    max-width: 170px;
    height: auto;
    display: block;
    margin-bottom: 14px;
  }

  .gerolamo-footer__tagline {
    margin: 0 0 20px 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.85);
    max-width: 260px;
  }

  .gerolamo-footer__socials {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .gerolamo-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #ffffff;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .gerolamo-footer__social-link:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .gerolamo-footer__social-link svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  /* Menu Columns */
  .gerolamo-footer__heading {
    margin: 0 0 16px 0;
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
  }

  .gerolamo-footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .gerolamo-footer__menu-item a {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.85);
  }

  .gerolamo-footer__menu-item a:hover {
    color: #ffffff;
    padding-left: 2px;
  }

  /* Column 5: Contact & Badge */
  .gerolamo-footer__contact-col {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (max-width: 576px) {
    .gerolamo-footer__contact-col {
      flex-direction: column;
      gap: 20px;
    }
  }

  .gerolamo-footer__contact-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .gerolamo-footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.9);
  }

  .gerolamo-footer__contact-item svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    fill: currentColor;
  }

  .gerolamo-footer__badge-wrap {
    flex-shrink: 0;
    width: 90px;
    height: 90px;
  }

  @media (max-width: 576px) {
    .gerolamo-footer__badge-wrap {
      width: 75px;
      height: 75px;
      margin-top: 10px;
    }
  }

  .gerolamo-footer__badge-wrap img,
  .gerolamo-footer__badge-wrap svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Bottom Bar */
  .gerolamo-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.75);
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 768px) {
    .gerolamo-footer__bottom {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }
  }

  .gerolamo-footer__bottom-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gerolamo-footer__bottom-links a {
    color: inherit;
  }

  .gerolamo-footer__bottom-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .gerolamo-container {
    width: 100%;
    max-width: var(--page-width, 1320px);
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }
  @media (max-width: 576px) {
    .gerolamo-container {
      padding-left: 14px;
      padding-right: 14px;
    }
  }
</style>

<footer class="gerolamo-footer"
        id="theme-section-{{ section.id }}"
        style="
          --footer-bg: {{ section.settings.bg_color | default: '#1B4B8A' }};
          --footer-text: {{ section.settings.text_color | default: '#ffffff' }};
          --footer-pt: {{ section.settings.padding_top }}px;
          --footer-pb: {{ section.settings.padding_bottom }}px;
        ">
  <div class="gerolamo-container">
    
    <!-- Top 5 Columns Grid -->
    <div class="gerolamo-footer__main-grid">
      
      <!-- Columna 1: Marca y Redes Sociales -->
      <div class="gerolamo-footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 350 }}"
               alt="{{ shop.name | escape }}"
               class="gerolamo-footer__logo"
               width="{{ section.settings.logo_width | default: 160 }}"
               height="50"
               loading="lazy">
        {%- else -%}
          <!-- Gerolamo Default White Logo SVG -->
          <div style="margin-bottom:14px;">
            <svg width="165" height="42" viewBox="0 0 200 50" fill="none" xmlns="http://www.w3.org/2000/svg">
              <text x="0" y="28" fill="#ffffff" font-family="'Montserrat', sans-serif" font-weight="900" font-size="25" letter-spacing="1">GER</text>
              <!-- Paw in O -->
              <circle cx="78" cy="22" r="10" stroke="#ffffff" stroke-width="2.5" fill="none"/>
              <ellipse cx="78" cy="24" rx="4" ry="3.2" fill="#ffffff"/>
              <circle cx="73.5" cy="17" r="1.6" fill="#ffffff"/>
              <circle cx="78" cy="15" r="1.6" fill="#ffffff"/>
              <circle cx="82.5" cy="17" r="1.6" fill="#ffffff"/>
              <text x="94" y="28" fill="#ffffff" font-family="'Montserrat', sans-serif" font-weight="900" font-size="25" letter-spacing="1">LAMO</text>
              <circle cx="178" cy="14" r="3.5" stroke="#ffffff" stroke-width="0.9" fill="none"/>
              <text x="178" y="16.5" fill="#ffffff" font-size="4" font-family="sans-serif" text-anchor="middle">R</text>
              <text x="40" y="42" fill="#ffffff" font-family="sans-serif" font-size="9" font-weight="500" letter-spacing="2">Superfood Premium</text>
            </svg>
          </div>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="gerolamo-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        <!-- Social Icons -->
        {%- if section.settings.social_instagram != blank or section.settings.social_facebook != blank or section.settings.social_youtube != blank or section.settings.social_whatsapp != blank -%}
        <div class="gerolamo-footer__socials">
          {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" class="gerolamo-footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
          <a href="{{ section.settings.social_facebook }}" class="gerolamo-footer__social-link" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.667 5H18V0h-3.808C10.592 0 9 1.592 9 4.792V8z"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
          <a href="{{ section.settings.social_youtube }}" class="gerolamo-footer__social-link" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.social_whatsapp != blank -%}
          <a href="{{ section.settings.social_whatsapp }}" class="gerolamo-footer__social-link" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          </a>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>

      <!-- Columna 2: PRODUCTOS -->
      <div class="gerolamo-footer__col">
        <h3 class="gerolamo-footer__heading">{{ section.settings.col2_title | default: 'PRODUCTOS' }}</h3>
        <ul class="gerolamo-footer__menu-list">
          {%- if section.settings.col2_menu != blank -%}
            {%- for link in linklists[section.settings.col2_menu].links -%}
              <li class="gerolamo-footer__menu-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="gerolamo-footer__menu-item"><a href="/collections/perros">Perros</a></li>
            <li class="gerolamo-footer__menu-item"><a href="/collections/gatos">Gatos</a></li>
            <li class="gerolamo-footer__menu-item"><a href="/collections/prescripcion-veterinaria">Prescripción Veterinaria</a></li>
            <li class="gerolamo-footer__menu-item"><a href="/collections/snacks">Snacks</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Columna 3: NOSOTROS -->
      <div class="gerolamo-footer__col">
        <h3 class="gerolamo-footer__heading">{{ section.settings.col3_title | default: 'NOSOTROS' }}</h3>
        <ul class="gerolamo-footer__menu-list">
          {%- if section.settings.col3_menu != blank -%}
            {%- for link in linklists[section.settings.col3_menu].links -%}
              <li class="gerolamo-footer__menu-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="gerolamo-footer__menu-item"><a href="/pages/nuestra-historia">Nuestra historia</a></li>
            <li class="gerolamo-footer__menu-item"><a href="/pages/calidad-y-compromiso">Calidad y compromiso</a></li>
            <li class="gerolamo-footer__menu-item"><a href="/blogs/news">Blog</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Columna 4: AYUDA -->
      <div class="gerolamo-footer__col">
        <h3 class="gerolamo-footer__heading">{{ section.settings.col4_title | default: 'AYUDA' }}</h3>
        <ul class="gerolamo-footer__menu-list">
          {%- if section.settings.col4_menu != blank -%}
            {%- for link in linklists[section.settings.col4_menu].links -%}
              <li class="gerolamo-footer__menu-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="gerolamo-footer__menu-item"><a href="/pages/distribuidores">Dónde comprar</a></li>
            <li class="gerolamo-footer__menu-item"><a href="/pages/contacto">Contacto</a></li>
            <li class="gerolamo-footer__menu-item"><a href="/pages/preguntas-frecuentes">Preguntas frecuentes</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Columna 5: CONTACTO & Sello Superfood -->
      <div class="gerolamo-footer__col">
        <h3 class="gerolamo-footer__heading">{{ section.settings.col5_title | default: 'CONTACTO' }}</h3>
        <div class="gerolamo-footer__contact-col">
          
          <div class="gerolamo-footer__contact-info">
            {%- if section.settings.phone != blank -%}
              <div class="gerolamo-footer__contact-item">
                <svg viewBox="0 0 24 24"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1A11.36 11.36 0 0 1 8.5 3.92c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.54c0-.54-.45-1-.99-1z"/></svg>
                <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a>
              </div>
            {%- endif -%}

            {%- if section.settings.email != blank -%}
              <div class="gerolamo-footer__contact-item">
                <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </div>
            {%- endif -%}

            {%- if section.settings.address != blank -%}
              <div class="gerolamo-footer__contact-item">
                <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>{{ section.settings.address }}</span>
              </div>
            {%- endif -%}
          </div>

          <!-- Superfood Metal Seal Badge -->
          <div class="gerolamo-footer__badge-wrap">
            {%- if section.settings.badge_image != blank -%}
              <img src="{{ section.settings.badge_image | image_url: width: 200 }}"
                   alt="Superfood Seal"
                   width="90"
                   height="90"
                   loading="lazy">
            {%- else -%}
              <!-- Metallic Blue/Silver Seal Badge SVG -->
              <svg viewBox="0 0 90 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="45" cy="45" r="43" fill="url(#silver_grad)" stroke="#c0c0c0" stroke-width="2"/>
                <circle cx="45" cy="45" r="35" fill="#1B4B8A"/>
                <circle cx="45" cy="45" r="33" stroke="#ffffff" stroke-width="1" stroke-dasharray="2 2"/>
                <path d="M41 31H49V39H57V47H49V55H41V47H33V39H41V31Z" fill="#ffffff"/>
                <path d="M45 36V50M38 43H52" stroke="#1B4B8A" stroke-width="2.2" stroke-linecap="round"/>
                <text x="45" y="27" fill="#ffffff" font-size="6" font-weight="700" text-anchor="middle" font-family="sans-serif">SUPERFOOD</text>
                <text x="45" y="62" fill="#ffffff" font-size="4.5" font-weight="600" text-anchor="middle" font-family="sans-serif">PRESCRIPCIÓN</text>
                <defs>
                  <linearGradient id="silver_grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#e6e6e6"/>
                    <stop offset="50%" stop-color="#999999"/>
                    <stop offset="100%" stop-color="#ffffff"/>
                  </linearGradient>
                </defs>
              </svg>
            {%- endif -%}
          </div>

        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="gerolamo-footer__bottom">
      <div class="gerolamo-footer__copyright">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.
      </div>
      
      <div class="gerolamo-footer__bottom-links">
        <a href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}">{{ section.settings.terms_text | default: 'Términos y condiciones' }}</a>
        <span>|</span>
        <a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">{{ section.settings.privacy_text | default: 'Política de privacidad' }}</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer Gerolamo",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Columna 1: Marca & Redes Sociales"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo del Footer (Blanco)",
      "info": "Si está vacío, se mostrará el logo vectorial Gerolamo en blanco."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Ancho del logo",
      "default": 160
    },
    {
      "type": "textarea",
      "id": "tagline",
      "default": "Nutrición premium para el bienestar de perros y gatos en cada etapa de su vida.",
      "label": "Eslogan / Descripción de marca"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Enlace Instagram"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Enlace Facebook"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "Enlace YouTube"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "Enlace WhatsApp"
    },
    {
      "type": "header",
      "content": "Columna 2: Productos"
    },
    {
      "type": "text",
      "id": "col2_title",
      "default": "PRODUCTOS",
      "label": "Título Columna 2"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Menú Columna 2"
    },
    {
      "type": "header",
      "content": "Columna 3: Nosotros"
    },
    {
      "type": "text",
      "id": "col3_title",
      "default": "NOSOTROS",
      "label": "Título Columna 3"
    },
    {
      "type": "link_list",
