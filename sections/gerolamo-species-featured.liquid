{% comment %}
  Gerolamo Featured Products by Species (Perros & Gatos) with Collection Tabs
{% endcomment %}

<style>
  .gerolamo-species-section {
    padding-top: var(--sec-pt-desktop, 40px);
    padding-bottom: var(--sec-pb-desktop, 60px);
  }

  @media (max-width: 576px) {
    .gerolamo-species-section {
      padding-top: var(--sec-pt-mobile, 25px);
      padding-bottom: var(--sec-pb-mobile, 40px);
    }
  }

  /* Section Title with lines */
  .gerolamo-species__header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-bottom: 36px;
    text-align: center;
  }

  .gerolamo-species__header-line {
    flex: 0 0 45px;
    height: 2px;
    background-color: var(--title-color, #1B4B8A);
    opacity: 0.6;
    border-radius: 2px;
  }

  .gerolamo-species__main-title {
    margin: 0;
    font-size: 24px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--title-color, #1B4B8A);
    letter-spacing: 0.04em;
  }

  @media (max-width: 576px) {
    .gerolamo-species__main-title {
      font-size: 20px;
    }
    .gerolamo-species__header-line {
      flex: 0 0 25px;
    }
  }

  /* Main 2-Column Grid */
  .gerolamo-species__columns-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  @media (max-width: 991px) {
    .gerolamo-species__columns-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* Species Box */
  .gerolamo-species-box {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.03);
  }

  /* Species Header Bar */
  .gerolamo-species-box__top {
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #ffffff;
  }

  .gerolamo-species-box__top-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gerolamo-species-box__top-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .gerolamo-species-box__top-title {
    margin: 0;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Inside Tabs */
  .gerolamo-species-box__tabs {
    display: flex;
    justify-content: space-around;
    padding: 16px 16px 8px 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    gap: 10px;
  }

  .gerolamo-species-tab-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
    padding: 6px 12px 10px 12px;
    position: relative;
    transition: color 0.2s ease;
  }

  .gerolamo-species-tab-btn:hover {
    color: var(--tab-accent, #0F6445);
  }

  .gerolamo-species-tab-btn.is-active {
    color: var(--tab-accent, #0F6445);
    font-weight: 700;
  }

  .gerolamo-species-tab-btn.is-active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 15%;
    right: 15%;
    height: 3px;
    background-color: var(--tab-accent, #0F6445);
    border-radius: 3px;
  }

  /* Products Grid */
  .gerolamo-species-tab-pane {
    display: none;
    padding: 20px 16px 16px 16px;
  }

  .gerolamo-species-tab-pane.is-active {
    display: block;
  }

  .gerolamo-species-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  @media (max-width: 576px) {
    .gerolamo-species-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  .gerolamo-mini-product {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
    padding: 6px 4px;
  }

  .gerolamo-mini-product:hover {
    transform: translateY(-4px);
  }

  .gerolamo-mini-product__img-wrap {
    width: 100%;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }

  .gerolamo-mini-product__img-wrap img {
    max-width: 100%;
    max-height: 120px;
    object-fit: contain;
  }

  .gerolamo-mini-product__title {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .gerolamo-mini-product__subtitle {
    margin: 3px 0 0 0;
    font-size: 11px;
    color: #64748b;
    line-height: 1.2;
  }

  /* Footer Link */
  .gerolamo-species-box__footer {
    margin-top: auto;
    padding: 12px 16px 18px 16px;
    text-align: center;
  }

  .gerolamo-species-box__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--tab-accent, #0F6445);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .gerolamo-species-box__link:hover {
    opacity: 0.85;
    text-decoration: underline;
  }
</style>

<div class="gerolamo-species-section"
     id="theme-section-{{ section.id }}"
     style="
       --sec-pt-desktop: {{ section.settings.padding_top_desktop }}px;
       --sec-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
       --sec-pt-mobile: {{ section.settings.padding_top_mobile }}px;
       --sec-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
       --title-color: {{ section.settings.title_color | default: '#1B4B8A' }};
     ">
  <div class="page-width">
    
    <!-- Section Title -->
    {%- if section.settings.main_title != blank -%}
      <div class="gerolamo-species__header">
        <span class="gerolamo-species__header-line"></span>
        <h2 class="gerolamo-species__main-title">{{ section.settings.main_title }}</h2>
        <span class="gerolamo-species__header-line"></span>
      </div>
    {%- endif -%}

    <div class="gerolamo-species__columns-grid">
      
      <!-- ==================== COLUMN 1: PERROS ==================== -->
      {%- liquid
        assign col1_coll1 = collections[section.settings.col1_tab1_collection]
        assign col1_coll2 = collections[section.settings.col1_tab2_collection]
        assign col1_coll3 = collections[section.settings.col1_tab3_collection]

        assign col1_tab1_title = section.settings.col1_tab1_name | default: col1_coll1.title | default: 'Mantención'
        assign col1_tab2_title = section.settings.col1_tab2_name | default: col1_coll2.title | default: 'Prescripción'
        assign col1_tab3_title = section.settings.col1_tab3_name | default: col1_coll3.title | default: 'Snacks'
      -%}
      <div class="gerolamo-species-box" style="--tab-accent: {{ section.settings.col1_accent | default: '#0F6445' }};">
        
        <!-- Header -->
        <div class="gerolamo-species-box__top" style="background-color: {{ section.settings.col1_header_bg | default: '#0F6445' }};">
          <span class="gerolamo-species-box__top-icon">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12c0 2.4.9 4.6 2.3 6.3L4 22l3.7-.3c1.3.8 2.8 1.3 4.3 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm-3.5 6c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5S7 10.3 7 9.5 7.7 8 8.5 8zm7 0c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5-1.5-.7-1.5-1.5.7-1.5 1.5-1.5zm-3.5 3c1.4 0 2.5 1.1 2.5 2.5S13.4 16 12 16s-2.5-1.1-2.5-2.5 1.1-2.5 2.5-2.5z"/></svg>
          </span>
          <h3 class="gerolamo-species-box__top-title">{{ section.settings.col1_title | default: 'PERROS' }}</h3>
        </div>

        <!-- Category Tabs -->
        <div class="gerolamo-species-box__tabs" role="tablist">
          <button type="button" class="gerolamo-species-tab-btn is-active" data-target="col1-tab1">{{ col1_tab1_title }}</button>
          <button type="button" class="gerolamo-species-tab-btn" data-target="col1-tab2">{{ col1_tab2_title }}</button>
          <button type="button" class="gerolamo-species-tab-btn" data-target="col1-tab3">{{ col1_tab3_title }}</button>
        </div>

        <!-- Tab 1 Products (Colección 1) -->
        <div class="gerolamo-species-tab-pane is-active" id="col1-tab1">
          <div class="gerolamo-species-products-grid">
            {%- if col1_coll1 != blank and col1_coll1.products_count > 0 -%}
              {%- for product in col1_coll1.products limit: 4 -%}
                <a href="{{ product.url }}" class="gerolamo-mini-product">
                  <div class="gerolamo-mini-product__img-wrap">
                    {%- if product.featured_image != blank -%}
                      <img src="{{ product.featured_image | image_url: width: 250 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
                    {%- endif -%}
                  </div>
                  <p class="gerolamo-mini-product__title">{{ product.title }}</p>
                  <p class="gerolamo-mini-product__subtitle">{{ product.metafields.descriptors.subtitle | default: product.type | default: 'Todas las razas' }}</p>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- render 'gerolamo-mini-product-item', title: 'Adulto', sub: 'Todas las razas' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Cachorro', sub: 'Todas las razas' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Senior', sub: 'Todas las razas' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Razas grandes', sub: 'Adulto' -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Tab 2 Products (Colección 2) -->
        <div class="gerolamo-species-tab-pane" id="col1-tab2">
          <div class="gerolamo-species-products-grid">
            {%- if col1_coll2 != blank and col1_coll2.products_count > 0 -%}
              {%- for product in col1_coll2.products limit: 4 -%}
                <a href="{{ product.url }}" class="gerolamo-mini-product">
                  <div class="gerolamo-mini-product__img-wrap">
                    {%- if product.featured_image != blank -%}
                      <img src="{{ product.featured_image | image_url: width: 250 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
                    {%- endif -%}
                  </div>
                  <p class="gerolamo-mini-product__title">{{ product.title }}</p>
                  <p class="gerolamo-mini-product__subtitle">{{ product.metafields.descriptors.subtitle | default: product.type | default: 'Cuidado específico' }}</p>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- render 'gerolamo-mini-product-item', title: 'Renal', sub: 'Cuidado renal' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Gastro', sub: 'Digestivo' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Skin Care', sub: 'Dermatológico' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Obesity', sub: 'Control peso' -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Tab 3 Products (Colección 3) -->
        <div class="gerolamo-species-tab-pane" id="col1-tab3">
          <div class="gerolamo-species-products-grid">
            {%- if col1_coll3 != blank and col1_coll3.products_count > 0 -%}
              {%- for product in col1_coll3.products limit: 4 -%}
                <a href="{{ product.url }}" class="gerolamo-mini-product">
                  <div class="gerolamo-mini-product__img-wrap">
                    {%- if product.featured_image != blank -%}
                      <img src="{{ product.featured_image | image_url: width: 250 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
                    {%- endif -%}
                  </div>
                  <p class="gerolamo-mini-product__title">{{ product.title }}</p>
                  <p class="gerolamo-mini-product__subtitle">{{ product.metafields.descriptors.subtitle | default: product.type | default: 'Premios saludables' }}</p>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- render 'gerolamo-mini-product-item', title: 'Dental', sub: 'Salud bucal' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Sticks', sub: 'Premios carne' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Bites', sub: 'Entrenamiento' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Crunchy', sub: 'Galletas' -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Footer Link -->
        {%- assign col1_url = section.settings.col1_footer_url | default: col1_coll1.url | default: '#' -%}
        {%- if section.settings.col1_footer_text != blank -%}
          <div class="gerolamo-species-box__footer">
            <a href="{{ col1_url }}" class="gerolamo-species-box__link">
              {{ section.settings.col1_footer_text }} →
            </a>
          </div>
        {%- endif -%}

      </div>

      <!-- ==================== COLUMN 2: GATOS ==================== -->
      {%- liquid
        assign col2_coll1 = collections[section.settings.col2_tab1_collection]
        assign col2_coll2 = collections[section.settings.col2_tab2_collection]
        assign col2_coll3 = collections[section.settings.col2_tab3_collection]

        assign col2_tab1_title = section.settings.col2_tab1_name | default: col2_coll1.title | default: 'Mantención'
        assign col2_tab2_title = section.settings.col2_tab2_name | default: col2_coll2.title | default: 'Prescripción'
        assign col2_tab3_title = section.settings.col2_tab3_name | default: col2_coll3.title | default: 'Snacks'
      -%}
      <div class="gerolamo-species-box" style="--tab-accent: {{ section.settings.col2_accent | default: '#3B702A' }};">
        
        <!-- Header -->
        <div class="gerolamo-species-box__top" style="background-color: {{ section.settings.col2_header_bg | default: '#3B702A' }};">
          <span class="gerolamo-species-box__top-icon">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12c0 2.4.9 4.6 2.3 6.3L4 22l3.7-.3c1.3.8 2.8 1.3 4.3 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm-3.5 6c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5S7 10.3 7 9.5 7.7 8 8.5 8zm7 0c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5-1.5-.7-1.5-1.5.7-1.5 1.5-1.5zm-3.5 3c1.4 0 2.5 1.1 2.5 2.5S13.4 16 12 16s-2.5-1.1-2.5-2.5 1.1-2.5 2.5-2.5z"/></svg>
          </span>
          <h3 class="gerolamo-species-box__top-title">{{ section.settings.col2_title | default: 'GATOS' }}</h3>
        </div>

        <!-- Category Tabs -->
        <div class="gerolamo-species-box__tabs" role="tablist">
          <button type="button" class="gerolamo-species-tab-btn is-active" data-target="col2-tab1">{{ col2_tab1_title }}</button>
          <button type="button" class="gerolamo-species-tab-btn" data-target="col2-tab2">{{ col2_tab2_title }}</button>
          <button type="button" class="gerolamo-species-tab-btn" data-target="col2-tab3">{{ col2_tab3_title }}</button>
        </div>

        <!-- Tab 1 Products (Colección 1) -->
        <div class="gerolamo-species-tab-pane is-active" id="col2-tab1">
          <div class="gerolamo-species-products-grid">
            {%- if col2_coll1 != blank and col2_coll1.products_count > 0 -%}
              {%- for product in col2_coll1.products limit: 4 -%}
                <a href="{{ product.url }}" class="gerolamo-mini-product">
                  <div class="gerolamo-mini-product__img-wrap">
                    {%- if product.featured_image != blank -%}
                      <img src="{{ product.featured_image | image_url: width: 250 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
                    {%- endif -%}
                  </div>
                  <p class="gerolamo-mini-product__title">{{ product.title }}</p>
                  <p class="gerolamo-mini-product__subtitle">{{ product.metafields.descriptors.subtitle | default: product.type | default: 'Indoor' }}</p>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- render 'gerolamo-mini-product-item', title: 'Adulto', sub: 'Indoor' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Castrado', sub: 'Control de peso' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Senior', sub: '+7 años' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Cachorro', sub: 'Hasta 12 meses' -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Tab 2 Products (Colección 2) -->
        <div class="gerolamo-species-tab-pane" id="col2-tab2">
          <div class="gerolamo-species-products-grid">
            {%- if col2_coll2 != blank and col2_coll2.products_count > 0 -%}
              {%- for product in col2_coll2.products limit: 4 -%}
                <a href="{{ product.url }}" class="gerolamo-mini-product">
                  <div class="gerolamo-mini-product__img-wrap">
                    {%- if product.featured_image != blank -%}
                      <img src="{{ product.featured_image | image_url: width: 250 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
                    {%- endif -%}
                  </div>
                  <p class="gerolamo-mini-product__title">{{ product.title }}</p>
                  <p class="gerolamo-mini-product__subtitle">{{ product.metafields.descriptors.subtitle | default: product.type | default: 'Salud específica' }}</p>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- render 'gerolamo-mini-product-item', title: 'Urinary', sub: 'Tracto urinario' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Renal', sub: 'Salud renal' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Gastro', sub: 'Fácil digestión' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Hypo', sub: 'Hipoalergénico' -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Tab 3 Products (Colección 3) -->
        <div class="gerolamo-species-tab-pane" id="col2-tab3">
          <div class="gerolamo-species-products-grid">
            {%- if col2_coll3 != blank and col2_coll3.products_count > 0 -%}
              {%- for product in col2_coll3.products limit: 4 -%}
                <a href="{{ product.url }}" class="gerolamo-mini-product">
                  <div class="gerolamo-mini-product__img-wrap">
                    {%- if product.featured_image != blank -%}
                      <img src="{{ product.featured_image | image_url: width: 250 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
                    {%- endif -%}
                  </div>
                  <p class="gerolamo-mini-product__title">{{ product.title }}</p>
                  <p class="gerolamo-mini-product__subtitle">{{ product.metafields.descriptors.subtitle | default: product.type | default: 'Premios para gatos' }}</p>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- render 'gerolamo-mini-product-item', title: 'Creamy', sub: 'Puré snack' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Crunchy', sub: 'Bocados crujientes' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Hairball', sub: 'Control bolas pelo' -%}
              {%- render 'gerolamo-mini-product-item', title: 'Dental Cat', sub: 'Cuidado dental' -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Footer Link -->
        {%- assign col2_url = section.settings.col2_footer_url | default: col2_coll1.url | default: '#' -%}
        {%- if section.settings.col2_footer_text != blank -%}
          <div class="gerolamo-species-box__footer">
            <a href="{{ col2_url }}" class="gerolamo-species-box__link">
              {{ section.settings.col2_footer_text }} →
            </a>
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    function initSpeciesTabs() {
      const section = document.getElementById('theme-section-{{ section.id }}');
      if (!section) return;
      const tabButtons = section.querySelectorAll('.gerolamo-species-tab-btn');
      tabButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          const parentBox = this.closest('.gerolamo-species-box');
          if (!parentBox) return;
          const targetId = this.getAttribute('data-target');
          
          parentBox.querySelectorAll('.gerolamo-species-tab-btn').forEach(b => b.classList.remove('is-active'));
          parentBox.querySelectorAll('.gerolamo-species-tab-pane').forEach(p => p.classList.remove('is-active'));
          
          this.classList.add('is-active');
          const targetPane = parentBox.querySelector('#' + targetId);
          if (targetPane) targetPane.classList.add('is-active');
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSpeciesTabs);
    } else {
      initSpeciesTabs();
    }
  })();
</script>

{% schema %}
{
  "name": "Destacados por Especie",
  "tag": "section",
  "class": "section-gerolamo-species",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "default": "PRODUCTOS DESTACADOS",
      "label": "Título Principal"
    },
    {
      "type": "color",
      "id": "title_color",
      "default": "#1B4B8A",
      "label": "Color del título"
    },
    {
      "type": "header",
      "content": "Columna 1: Perros"
    },
    {
      "type": "text",
      "id": "col1_title",
      "default": "PERROS",
      "label": "Título de cabecera"
    },
    {
      "type": "color",
      "id": "col1_header_bg",
      "default": "#0F6445",
      "label": "Fondo de cabecera"
    },
    {
      "type": "color",
      "id": "col1_accent",
      "default": "#0F6445",
      "label": "Color de acento / pestañas"
    },
    {
      "type": "paragraph",
      "content": "--- Pestaña 1 ---"
    },
    {
      "type": "collection",
      "id": "col1_tab1_collection",
      "label": "Colección Pestaña 1 (Perros)"
    },
    {
      "type": "text",
